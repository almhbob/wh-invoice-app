rules_version = '2';

// Secure rules — require server-verified sign-in (Cloudflare function /api/auth/login).
// Every employee session carries custom claims: companyId, role, eid (employee doc id).
// platformRole is issued only for a server-managed platformOwners marker.
// Activate ONLY after /api/auth/status reports {"configured": true}. See SECURITY_SETUP.md.
// Rollback: publish firestore.legacy.rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'custom';
    }
    function inCompany(companyId) {
      return signedIn() && request.auth.token.companyId == companyId;
    }
    function role() {
      return request.auth.token.role;
    }
    function isAdmin(companyId) {
      return inCompany(companyId) && role() == 'admin';
    }
    function isManager(companyId) {
      return inCompany(companyId) && role() in ['admin', 'branch_supervisor'];
    }
    function noPlaintextPin() {
      return !('pinCode' in request.resource.data)
        || (resource != null && request.resource.data.pinCode == resource.data.pinCode);
    }
    function supervisorMayAssign(data) {
      return role() == 'admin' || !(data.role in ['admin', 'branch_supervisor']);
    }
    function isPlatformRole(data) {
      return data.role in ['owner', 'developer', 'super_admin'] || 'platformRole' in data;
    }
    function isPlatformOwnerAccount(companyId, employeeId) {
      return exists(/databases/$(database)/documents/platformOwners/$(companyId + '__' + employeeId));
    }
    function isPlatformProtectedEmployee(companyId, employeeId, data) {
      return isPlatformRole(data) || isPlatformOwnerAccount(companyId, employeeId);
    }

    function isPlatformStaff() {
      return signedIn() && request.auth.token.platformRole in ['owner', 'developer', 'super_admin'];
    }

    // Trial requests from the public /join page: created by the server only;
    // platform staff read them and move them through the follow-up statuses.
    match /platformLeads/{id} {
      allow read: if isPlatformStaff();
      allow update: if isPlatformStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'followUpNote', 'updatedAt', 'handledBy'])
        && request.resource.data.status in ['new', 'contacted', 'trial', 'won', 'lost'];
      allow create, delete: if false;
    }

    // Platform-owner markers are written by the trusted service account only.
    match /platformOwners/{ownerId} {
      allow read, write: if false;
    }

    // Company metadata
    match /companies/{companyId} {
      allow read: if inCompany(companyId);
      allow write: if isAdmin(companyId);
    }

    // Hashed PINs — server only.
    match /companies/{companyId}/employeeSecrets/{id} {
      allow read, write: if false;
    }

    // Employees: readable by colleagues; only managers create/edit; never with a plaintext PIN.
    match /companies/{companyId}/employees/{id} {
      allow read: if inCompany(companyId);
      allow create: if isManager(companyId)
        && !isPlatformProtectedEmployee(companyId, id, request.resource.data)
        && noPlaintextPin()
        && supervisorMayAssign(request.resource.data);
      allow update: if isManager(companyId)
        && (role() == 'admin' || request.resource.data.role == resource.data.role)
        && !isPlatformProtectedEmployee(companyId, id, resource.data)
        && !isPlatformProtectedEmployee(companyId, id, request.resource.data)
        && noPlaintextPin()
        && supervisorMayAssign(resource.data)
        && supervisorMayAssign(request.resource.data);
      allow delete: if isManager(companyId)
        && !isPlatformProtectedEmployee(companyId, id, resource.data)
        && supervisorMayAssign(resource.data);
    }

    // Audit records are tenant-scoped, tied to the signed-in employee, and append-only.
    match /companies/{companyId}/auditLogs/{logId} {
      allow read: if isAdmin(companyId);
      allow create: if inCompany(companyId)
        && request.resource.data.keys().hasOnly(['action', 'actorId', 'actorName', 'targetId', 'targetType', 'details', 'createdAt'])
        && request.resource.data.keys().hasAll(['action', 'actorId', 'actorName', 'targetId', 'targetType', 'details', 'createdAt'])
        && request.resource.data.actorId == request.auth.token.eid
        && request.resource.data.action in ['employee_created', 'employee_deleted', 'developer_panel_opened', 'contract_uploaded', 'subscription_changed', 'company_login', 'user_login']
        && request.resource.data.actorName is string
        && request.resource.data.details is map
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // Tax registration printed on invoices: every employee prints it, only the admin edits it.
    match /companies/{companyId}/taxProfile/{docId} {
      allow read: if inCompany(companyId);
      allow write: if isAdmin(companyId) && docId == 'current';
    }

    // Sales windows (branches): everyone sees them, managers set them up.
    match /companies/{companyId}/windows/{id} {
      allow read: if inCompany(companyId);
      allow write: if isManager(companyId);
    }

    // Each window's daily order from the factory. Staff create and move it along;
    // only managers may delete one.
    match /companies/{companyId}/windowOrders/{id} {
      allow read: if inCompany(companyId);
      allow create, update: if inCompany(companyId)
        && request.resource.data.windowId is string
        && request.resource.data.date is string
        && request.resource.data.status in ['sent', 'dispatched', 'received']
        && id == request.resource.data.windowId + '_' + request.resource.data.date;
      allow delete: if isManager(companyId);
    }

    // Everything else inside a company (orders, products, counters, settings, sessions, logs…)
    match /companies/{companyId}/{sub}/{docId=**} {
      allow read, write: if inCompany(companyId)
        && !(sub in ['employees', 'employeeSecrets', 'auditLogs', 'taxProfile', 'windows', 'windowOrders']);
    }

    // Login throttling state — server only.
    match /authThrottle/{key} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
