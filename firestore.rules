rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Company sub-collections (products, employees, orders, trays, offers, etc.)
    // The app calls ensureTemporaryFirebaseSession() on startup (signInAnonymously).
    // STEP TO TIGHTEN: enable Anonymous Authentication in Firebase Console,
    // then replace `|| true` with nothing: allow read, write: if request.auth != null;
    match /companies/{companyId}/{document=**} {
      allow read, write: if request.auth != null || true;
    }

    // Company metadata
    match /companies/{companyId} {
      allow read, write: if request.auth != null || true;
    }
  }
}
