rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Company sub-collections (products, employees, orders, trays, offers, etc.)
    // Allow all reads/writes — anonymous auth is currently disabled in Firebase Console.
    // To tighten security: enable Anonymous Authentication in Firebase Console first,
    // then change the rule back to: allow read, write: if request.auth != null;
    match /companies/{companyId}/{document=**} {
      allow read, write: if true;
    }

    // Company metadata — public read, unrestricted write for now
    match /companies/{companyId} {
      allow read, write: if true;
    }
  }
}
