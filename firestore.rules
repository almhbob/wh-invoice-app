rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.companyId is string
        && request.auth.token.employeeDocId is string;
    }
    function employeePath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/employees/$(request.auth.token.employeeDocId);
    }
    function member(companyId) {
      return verified() && request.auth.token.companyId == companyId
        && exists(employeePath(companyId))
        && get(employeePath(companyId)).data.authUid == request.auth.uid
        && get(employeePath(companyId)).data.companyId == companyId
        && get(employeePath(companyId)).data.status == 'active'
        && get(employeePath(companyId)).data.role in [
          'admin', 'branch_supervisor', 'cashier', 'halwa', 'mawali',
          'chocolate', 'cake', 'packaging', 'dept_supervisor', 'guest'
        ];
    }
    function role(companyId) { return get(employeePath(companyId)).data.role; }
    function admin(companyId) { return member(companyId) && role(companyId) == 'admin'; }
    function manager(companyId) {
      return member(companyId) && role(companyId) in ['admin', 'branch_supervisor'];
    }
    function cashier(companyId) {
      return member(companyId) && role(companyId) in ['admin', 'branch_supervisor', 'cashier'];
    }
    function tenantPayload(companyId) { return request.resource.data.companyId == companyId; }
    function cleanProfile(data) {
      return !data.keys().hasAny(['pinCode', 'password', 'passwordHash', 'pinHash']);
    }
    function operationalRole(value) {
      return value in ['cashier', 'halwa', 'mawali', 'chocolate', 'cake', 'packaging', 'dept_supervisor', 'guest'];
    }
    function validRole(value) { return operationalRole(value) || value in ['admin', 'branch_supervisor']; }
    function branchCanManage(companyId, data) {
      return manager(companyId) && role(companyId) == 'branch_supervisor'
        && operationalRole(data.role)
        && data.branchId is string && data.branchId.size() > 0
        && data.branchId == get(employeePath(companyId)).data.branchId;
    }
    function departmentUpdate(companyId) {
      let ownRole = role(companyId);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return ownRole in ['halwa', 'mawali', 'chocolate', 'cake', 'packaging', 'dept_supervisor']
        && changed.hasOnly(['departmentStatuses', 'departmentReceivers', 'updatedAt'])
        && (ownRole == 'dept_supervisor' || (
          request.resource.data.departmentStatuses.diff(resource.data.departmentStatuses).affectedKeys().hasOnly([ownRole])
          && request.resource.data.get('departmentReceivers', {}).diff(resource.data.get('departmentReceivers', {})).affectedKeys().hasOnly([ownRole])
        ));
    }

    match /companies/{companyId} {
      allow read: if member(companyId);
      // Plans, limits and company activation require the trusted Admin SDK.
      allow write: if false;
      match /employees/{employeeId} {
        allow get: if member(companyId) && cleanProfile(resource.data);
        // Set only by trusted migration tooling after scrubbing all profiles.
        // Query authorization cannot safely filter documents by missing fields.
        allow list: if member(companyId)
          && get(/databases/$(database)/documents/companies/$(companyId)).data.authMigrationVersion == 1;
        allow create: if tenantPayload(companyId) && cleanProfile(request.resource.data)
          && validRole(request.resource.data.role)
          && request.resource.data.status in ['active', 'suspended']
          && request.resource.data.keys().hasOnly(['name', 'employeeId', 'username', 'companyId', 'role', 'status', 'branchId', 'createdBy', 'createdAt'])
          && (admin(companyId) || branchCanManage(companyId, request.resource.data));
        allow update: if tenantPayload(companyId) && cleanProfile(request.resource.data)
          && validRole(request.resource.data.role)
          && request.resource.data.status in ['active', 'suspended']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'status'])
          && (admin(companyId) || (
            branchCanManage(companyId, resource.data) && branchCanManage(companyId, request.resource.data)
          ));
        allow delete: if admin(companyId) || branchCanManage(companyId, resource.data);
      }
      match /orders/{orderId} {
        allow read: if member(companyId);
        allow create: if cashier(companyId) && tenantPayload(companyId)
          && request.resource.data.orderNumber is int && request.resource.data.orderNumber > 0;
        allow update: if member(companyId) && tenantPayload(companyId)
          && request.resource.data.orderNumber == resource.data.orderNumber
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            manager(companyId)
            || (cashier(companyId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleted', 'deletedAt', 'deletedBy']))
            || departmentUpdate(companyId)
            || (role(companyId) == 'packaging'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trayReturned', 'trayReturnedAt', 'trayReturnedBy', 'updatedAt']))
          );
        allow delete: if admin(companyId);
      }
      match /counters/{counterId} {
        allow read: if member(companyId);
        allow create, update: if cashier(companyId) && tenantPayload(companyId)
          && request.resource.data.value is int && request.resource.data.value > 0
          && (!exists(/databases/$(database)/documents/companies/$(companyId)/counters/$(counterId))
            || request.resource.data.value == resource.data.value + 1);
        allow delete: if admin(companyId);
      }
      match /products/{productId} {
        allow read: if member(companyId);
        allow create: if admin(companyId) && tenantPayload(companyId);
        allow update: if tenantPayload(companyId) && (
          admin(companyId) || (manager(companyId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAvailable', 'updatedAt']))
        );
        allow delete: if admin(companyId);
      }
      match /offers/{offerId} {
        allow read: if member(companyId);
        allow create: if manager(companyId) && tenantPayload(companyId);
        allow update: if tenantPayload(companyId) && (
          manager(companyId) || (cashier(companyId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
            && request.resource.data.usageCount == resource.data.usageCount + 1)
        );
        allow delete: if manager(companyId);
      }
      match /settings/{settingId} {
        allow read: if member(companyId);
        allow create, update: if admin(companyId) && tenantPayload(companyId);
        allow delete: if admin(companyId);
      }
      match /priceChangeRequests/{requestId} {
        allow read: if member(companyId);
        allow create: if member(companyId) && role(companyId) != 'guest'
          && tenantPayload(companyId) && request.resource.data.status == 'pending';
        allow update: if admin(companyId) && tenantPayload(companyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt']);
        allow delete: if admin(companyId);
      }
      match /closedShifts/{shiftId} {
        allow read: if cashier(companyId);
        allow create: if cashier(companyId) && tenantPayload(companyId);
        allow update, delete: if false;
      }
      match /{collectionName}/{recordId} {
        allow read: if collectionName in ['branchProductionRequests', 'branchInventoryAudits', 'trays'] && member(companyId);
        allow create, update: if collectionName in ['branchProductionRequests', 'branchInventoryAudits', 'trays']
          && manager(companyId) && tenantPayload(companyId);
        allow delete: if collectionName in ['branchProductionRequests', 'branchInventoryAudits', 'trays'] && admin(companyId);
      }
      match /auditLogs/{logId} {
        allow read: if manager(companyId);
        allow create: if member(companyId) && role(companyId) != 'guest'
          && tenantPayload(companyId) && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /subscriptionActivationRequests/{requestId} {
      allow create: if manager(request.resource.data.companyId) && request.resource.data.status == 'submitted';
      allow read, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
