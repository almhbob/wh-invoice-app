NODE_ENV=production
EXPO_PUBLIC_API_BASE=https://fotra-dv1.pages.dev
# For native staging builds, EXPO_PUBLIC_APP_ENV=staging routes auth to https://fotra-staging.pages.dev.
EXPO_PUBLIC_FIREBASE_API_KEY=replace_me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_me
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace_me
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_me
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_me
EXPO_PUBLIC_FIREBASE_APP_ID=replace_me
# Optional: set to `staging` for native/preview staging builds; staging never falls back to production config.
# EXPO_PUBLIC_APP_ENV=staging
# Local-only fallback for development when server-side auth is unavailable; never enable in production.
EXPO_PUBLIC_ALLOW_LEGACY_AUTH=false
# Optional: AI invoice analysis endpoint (defaults to http://127.0.0.1:3000 for local Termux server)
EXPO_PUBLIC_AI_ENDPOINT=
