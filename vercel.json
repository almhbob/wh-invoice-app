{
  "buildCommand": "npm run build",
  "outputDirectory": "static-build",
  "installCommand": "npm install --include=dev --legacy-peer-deps --no-audit --no-fund",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/healthz",
      "destination": "/healthz.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
